# Soul Compiler — environment configuration
#
# Copy to `.env.local` and fill in for your machine. Bun loads it automatically.
# `.env.local` is gitignored; nothing here should ever be committed with real values.

# Parent directory holding one `<agent>-workspace/` per agent.
# This is where compiled identity files get deployed.
SOUL_WORKSPACE_BASE=~/agent-workspaces

# Soul config tree: 1_sources/, 2_references/, 3_trait_cards/, 4_compiled/, agent.<name>/
SOUL_CONFIG_DIR=~/.soul-compiler

# Agents to operate on. Leave unset to auto-discover from SOUL_WORKSPACE_BASE
# (any directory named `<name>-workspace`). Comma-separated when set explicitly.
# SOUL_AGENTS=alpha,beta,gamma

# Host your agents actually run on, for the tools that read deployed files
# (bootstrap-headroom, deploy-diff-gate, fold-orphans). Any ssh target.
# Required by those tools — they refuse to guess. Leave unset if everything is local.
# SOUL_REMOTE_HOST=my-server

# Runtime gateway port, used to restart after deploy.
# SOUL_GATEWAY_PORT=18789

# Web UI port.
# SOUL_WEB_PORT=3000

# Session registry the runtime keeps, cleared after a deploy so the agent
# reloads its identity. Defaults to <SOUL_CONFIG_DIR>/sessions.json
# SOUL_SESSIONS_PATH=~/.soul-compiler/sessions.json

# Runtime config file, read to enumerate the agents your runtime knows about.
# Defaults to ~/.openclaw/openclaw.json
# SOUL_RUNTIME_CONFIG=~/.openclaw/openclaw.json
